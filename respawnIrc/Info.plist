<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Description du bundle macOS, reprise du modèle fourni par Qt et complétée : le modèle par
     défaut ne donne ni nom lisible ni version, que le Finder affiche, et laisse implicite la
     compatibilité avec les écrans à haute densité. Les ${...} sont remplacés par qmake à partir
     des variables du .pro. -->
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key>
	<string>${EXECUTABLE_NAME}</string>
	<key>CFBundleName</key>
	<string>RespawnIRC</string>
	<key>CFBundleDisplayName</key>
	<string>RespawnIRC</string>
	<key>CFBundleIconFile</key>
	<string>${ASSETCATALOG_COMPILER_APPICON_NAME}</string>
	<key>CFBundleIdentifier</key>
	<string>${PRODUCT_BUNDLE_IDENTIFIER}</string>
	<!-- À garder en phase avec currentVersionName dans respawnIrc.cpp. Le @SHORT_VERSION@ de qmake
	     ne servirait à rien ici, il tronque la version à ses deux premiers nombres. -->
	<key>CFBundleShortVersionString</key>
	<string>3.1.17</string>
	<key>CFBundleVersion</key>
	<string>3.1.17</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleSignature</key>
	<string>${QMAKE_PKGINFO_TYPEINFO}</string>
	<key>LSMinimumSystemVersion</key>
	<string>${MACOSX_DEPLOYMENT_TARGET}</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSSupportsAutomaticGraphicsSwitching</key>
	<true/>
</dict>
</plist>
